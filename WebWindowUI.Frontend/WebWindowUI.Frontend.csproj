<Project Sdk="Microsoft.NET.Sdk">

  <!-- TFM 必须与核心库一致（net10.0 引用不了 net10.0-windows），平台选择集中在 WebWindowUI.Platform.props -->
  <Import Project="..\WebWindowUI\WebWindowUI.Platform.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>WebWindowUI.Frontend</PackageId>
    <Description>WebWindowUI 前端角色标记库：前端（Vue + Vite）工程引用本包即声明角色，WebWindowUI.targets 据此激活 vite 构建目标。引用本包自动带回 WebWindowUI 核心（共享构建目标 + 生成器）。</Description>
    <PackageTags>webwindowui;webview2;vue;desktop</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebWindowUI\WebWindowUI.csproj" />
  </ItemGroup>

</Project>
