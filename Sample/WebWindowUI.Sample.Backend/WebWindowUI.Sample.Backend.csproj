<Project Sdk="Microsoft.NET.Sdk">

  <!-- 平台选择（TFM 与核心库一致）集中在 WebWindowUI.Platform.props -->
  <Import Project="..\..\WebWindowUI\WebWindowUI.Platform.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WebWindowUI.Backend\WebWindowUI.Backend.csproj" />
    <ProjectReference Include="..\..\WebWindowUI.Generator.SourceGen\WebWindowUI.Generator.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <Import Project="..\..\WebWindowUI\WebWindowUI.targets" />


  <!-- PDB 内嵌策略显式化：Debug=portable（独立 .pdb）、Release=embedded（符号随程序集，无独立 .pdb 文件）。
       仓库工程与根 Directory.Build.props 的 Release=embedded 重复但无害（自包含）；模板生成工程无根 props，靠这里保证。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
