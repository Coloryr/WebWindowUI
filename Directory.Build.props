<Project>

  <!-- 仓库统一打包元数据：WebWindowUI 包共享版本与作者。
       所有工程（含测试）继承 Version（写入 AssemblyInfo），对不打包的工程无副作用。 -->

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Color_yr</Authors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Release 下 PDB 内嵌进程序集（DebugType=embedded）：符号随程序集走，不散出独立 .pdb 文件。
         发布单文件（PublishSingleFile）时符号一起打进 exe。所有工程含库统一继承，无需逐个 csproj 写。 -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

</Project>
