<Project Sdk="Microsoft.NET.Sdk">

  <!-- 平台选择与框架一致：Windows 上 net10.0-windows（WINDOWS 符号，跑真 WebView2 集成测试），
       Linux/macOS 上 net10.0 / net10.0-macos（无 WINDOWS 符号 → WebView2/STA 相关文件被 #if 排除，
       只编译运行纯逻辑测试）。 -->
  <Import Project="..\WebWindowUI\WebWindowUI.Platform.props" />
  <!-- 仓库模式手动 Import 共享 targets（同 Sample 各工程）：测试工程是 WebWindow 宿主（TestWindow 继承 WebWindow），
       Release 下经 _WWUI_InjectFrontendLoad 注入 FrontendLoad.cs——前端发现沿引用链传递（_WWUI_ReportFrontend
       透传应用工程的前端），测试进程自身被加载即触发前端 dll 加载（内嵌 wwwroot 可被 resolver 扫到）。 -->
  <Import Project="..\WebWindowUI\WebWindowUI.targets" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="protobuf-net" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebWindowUI.Core\WebWindowUI.Core.csproj" />
    <ProjectReference Include="..\WebWindowUI.Generator.SourceGen\WebWindowUI.Generator.SourceGen.csproj" />
    <ProjectReference Include="..\Sample\WebWindowUI.Sample.Backend\WebWindowUI.Sample.Backend.csproj" />
    <ProjectReference Include="..\Sample\WebWindowUI.Sample\WebWindowUI.Sample.csproj" />
  </ItemGroup>

  <!-- 平台实现 dll：仓库模式（构建/测试，不传 WWUI_PlatformRef）下 core 的包级平台引用被门控关闭，
       核心产物不带平台 dll，测试必须直接 ProjectReference 平台工程才能拿到平台程序集（编译经 core 的
       IVT 访问平台 internal 成员 + 运行时 WebWindowPlatform.Assembly.Load 加载它）。
       包模式消费方则由 core 的 nuspec 平台依赖自动带回，无需任何直接引用。 -->
  <ItemGroup Condition="'$(WWUIPlatform)' == 'Windows'">
    <ProjectReference Include="..\WebWindowUI.Platforms.Windows\WebWindowUI.Platforms.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WWUIPlatform)' == 'Linux'">
    <ProjectReference Include="..\WebWindowUI.Platforms.Linux\WebWindowUI.Platforms.Linux.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WWUIPlatform)' == 'MacOS'">
    <ProjectReference Include="..\WebWindowUI.Platforms.MacOS\WebWindowUI.Platforms.MacOS.csproj" />
  </ItemGroup>


  <!-- PDB 内嵌策略显式化：Debug=portable（独立 .pdb）、Release=embedded（符号随程序集，无独立 .pdb 文件）。
       仓库工程与根 Directory.Build.props 的 Release=embedded 重复但无害（自包含）；模板生成工程无根 props，靠这里保证。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
