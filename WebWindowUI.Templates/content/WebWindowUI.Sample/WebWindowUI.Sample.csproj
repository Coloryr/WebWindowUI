<Project Sdk="Microsoft.NET.Sdk">

  <!-- 平台选择（TFM + WINDOWS/LINUX/MACOS 编译符号）集中在 WebWindowUI.Platform.props（随模板生成）
       默认按构建机选平台：Windows=net10.0-windows+WinExe，Linux=net10.0+Exe，macOS=net10.0-macos+Exe；
       交叉编译可用 -p:WWUIPlatform=Linux/MacOS 覆盖。 -->
  <Import Project="WebWindowUI.Platform.props" />

  <PropertyGroup>
    <OutputType Condition="'$(WWUIPlatform)' == 'Windows'">WinExe</OutputType>
    <OutputType Condition="'$(WWUIPlatform)' != 'Windows'">Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WebWindowUI" />
    <ProjectReference Include="..\WebWindowUI.Sample.Backend\WebWindowUI.Sample.Backend.csproj" />
    <ProjectReference Include="..\WebWindowUI.Sample.Frontend\WebWindowUI.Sample.Frontend.csproj" />
  </ItemGroup>

</Project>
