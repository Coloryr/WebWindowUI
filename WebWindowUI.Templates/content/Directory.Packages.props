<Project>

  <!-- 集中版本管理（CPM）：生成的工程 PackageReference 只写 Include，版本统一在此定义。
       NuGet 从工程目录向上查找本文件（本文件随模板生成到工程根，与 slnx 同级）。
       WebWindowUI 系列版本须随框架版本同步（当前 0.1.0，见仓库 Directory.Packages.props）。 -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="WebWindowUI" Version="0.1.0" />
    <PackageVersion Include="WebWindowUI.Backend" Version="0.1.0" />
    <PackageVersion Include="WebWindowUI.Frontend" Version="0.1.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="GirCore.GLib-2.0" Version="0.8.1" />
  </ItemGroup>

</Project>
