<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WebWindowUI.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Title>WebWindowUI 桌面应用模板</Title>
    <Description>dotnet new 模板：WebWindowUI 桌面应用（.NET 模型库 + Vue/Vite 前端 + 跨平台应用：Windows=WebView2 / Linux=WebKitGTK / macOS=WKWebView）三工程骨架。单窗口，模型双向绑定 + MVVM 命令。</Description>
    <PackageTags>webwindowui;template;webview2;webkitgtk;vue;desktop;linux;macos</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**" Exclude="content\**\bin\**;content\**\obj\**;content\**\node_modules\**"
             Pack="true" PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>


  <!-- PDB 内嵌策略显式化：Debug=portable（独立 .pdb）、Release=embedded（符号随程序集，无独立 .pdb 文件）。
       仓库工程与根 Directory.Build.props 的 Release=embedded 重复但无害（自包含）；模板生成工程无根 props，靠这里保证。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
