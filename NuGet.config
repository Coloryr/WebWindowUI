<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="webwindowui-local" value="artifacts" />
    <!-- CEF 平台经 CefSharp 包需要 nuget.org（chromiumembeddedframework.runtime / CefSharp.* 不在本地源） -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
