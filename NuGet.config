<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 本地打包产物源：dotnet pack -o artifacts 后，PackageReference WebWindowUI（模板工程默认用法）
         即从该源解析本地包。不做 <clear />，保留用户/机器级既有源（镜像等）。 -->
    <add key="webwindowui-local" value="artifacts" />
  </packageSources>
</configuration>
