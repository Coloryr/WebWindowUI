<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="webwindowui-local" value="artifacts" />
    <!-- CefGlue.Next 补丁包（CEF 150 代，含 InternalsVisibleTo/BrowserClosed 改动）由上游 E:\temp_code\CefGlue 打包产出 -->
    <add key="cefglue-local" value="E:\temp_code\CefGlue\Nuget\output" />
    <!-- CEF 运行时包（chromiumembeddedframework.runtime* 150.0.11）来自 nuget.org -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
