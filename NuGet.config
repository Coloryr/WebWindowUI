<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="webwindowui-local" value="artifacts" />
    <!-- CEF 运行时包（chromiumembeddedframework.runtime* 150.0.11）来自 nuget.org；CefGlue.Next.* 包由
         vendored 源码（third-party/CefGlue，CEF 150 代）构建进 artifacts（webwindowui-local），无独立补丁源 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
