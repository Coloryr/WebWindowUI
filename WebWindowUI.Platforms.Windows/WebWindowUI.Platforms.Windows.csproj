<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 平台实现（WebView2 + Win32 P/Invoke）：独立包，由 WebWindowUI 核心包按平台自动引入。
       硬编码 net10.0-windows + WINDOWS 编译符号，使文件内 #if WINDOWS 门控原样保留（本工程内恒真）。 -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>WebWindowUI.Platforms.Windows</PackageId>
    <Description>WebWindowUI Windows 平台实现：WebView2 窗口宿主 + Win32 P/Invoke。由核心包 WebWindowUI 按平台自动引入，消费方无需显式引用。</Description>
    <PackageTags>webwindowui;webview2;windows</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- 平台注册走 [ModuleInitializer]（程序集加载即注册平台实现），库场景属 CA2255 预期用法 -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- 反向引用核心（WebWindowUI.Core，非入口包 WebWindowUI）：PrivateAssets=all 抑制 pack 依赖——
       本包由入口包引入，入口已带 Core，nuspec 不必重复声明（声明了也无环，Core 不依赖本包）。
       编译期仍拿到 Core 的全部类型与 internal（IVT）。 -->
  <ItemGroup>
    <ProjectReference Include="..\WebWindowUI.Core\WebWindowUI.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebWindowUI.Tests" />
  </ItemGroup>


  <!-- PDB 内嵌策略显式化：Debug=portable（独立 .pdb）、Release=embedded（符号随程序集，无独立 .pdb 文件）。
       仓库工程与根 Directory.Build.props 的 Release=embedded 重复但无害（自包含）；模板生成工程无根 props，靠这里保证。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
