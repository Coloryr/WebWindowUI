<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS 平台实现（NSWindow + WKWebView，盲写）：独立包，由 WebWindowUI 核心包按平台自动引入。
       硬编码 net10.0-macos + MACOS 编译符号，使文件内 #if MACOS 门控原样保留（本工程内恒真）。
       只能在本机 Mac + dotnet workload install macos 上构建/打包（Windows 编译不了，见 CLAUDE.md 平台拆分一节）。 -->

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>WebWindowUI.Platforms.MacOS</PackageId>
    <Description>WebWindowUI macOS 平台实现：NSWindow + WKWebView。由核心包 WebWindowUI 按平台自动引入。</Description>
    <PackageTags>webwindowui;wkwebview;macos</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    <!-- 平台注册走 [ModuleInitializer]（程序集加载即注册平台实现），库场景属 CA2255 预期用法 -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

  <!-- 反向引用核心（WebWindowUI.Core，非入口包 WebWindowUI）：PrivateAssets=all 抑制 pack 依赖，
       本包由入口包引入、入口已带 Core；编译期仍拿到 Core 的全部类型与 internal（IVT）。 -->
  <ItemGroup>
    <ProjectReference Include="..\WebWindowUI.Core\WebWindowUI.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebWindowUI.Tests" />
  </ItemGroup>


  <!-- PDB 内嵌策略显式化：Debug=portable（独立 .pdb）、Release=embedded（符号随程序集，无独立 .pdb 文件）。
       仓库工程与根 Directory.Build.props 的 Release=embedded 重复但无害（自包含）；模板生成工程无根 props，靠这里保证。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
