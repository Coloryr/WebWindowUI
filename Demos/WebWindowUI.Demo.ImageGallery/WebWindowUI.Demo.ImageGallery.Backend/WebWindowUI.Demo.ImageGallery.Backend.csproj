<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- WPF 文件选择对话框（Microsoft.Win32.OpenFileDialog）需要 -windows TFM：Windows 上覆盖为
         net10.0-windows（消费方应用同步覆盖，见 App csproj）；Linux/macOS 保持 net10.0，模型内
         #if WINDOWS 分支编译掉、UseWPF 也不启用。 -->
    <TargetFramework Condition="'$(WWUIPlatform)' == 'Windows'">net10.0-windows</TargetFramework>
    <UseWPF Condition="'$(WWUIPlatform)' == 'Windows'">true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只引用 WebWindowUI 角色标记包：CommunityToolkit.Mvvm 经包依赖图自动传递。 -->
    <PackageReference Include="WebWindowUI.Backend" />
  </ItemGroup>


  <!-- PDB 内嵌策略显式化：Debug=portable（独立 .pdb）、Release=embedded（符号随程序集，无独立 .pdb 文件）。
       仓库工程与根 Directory.Build.props 的 Release=embedded 重复但无害（自包含）；模板生成工程无根 props，靠这里保证。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
