<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 配置键控：Debug=Exe（开发控制台看日志）、Release=WinExe（无控制台窗口）。
         WinExe 的 WindowsSubsystem 仅 Windows 生效，Linux/macOS 上等效于 Exe。 -->
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WebWindowUI" />
    <ProjectReference Include="..\WebWindowUI.Demo.ImageGallery.Backend\WebWindowUI.Demo.ImageGallery.Backend.csproj" />
    <ProjectReference Include="..\WebWindowUI.Demo.ImageGallery.Frontend\WebWindowUI.Demo.ImageGallery.Frontend.csproj" />
  </ItemGroup>


  <!-- PDB 内嵌策略显式化：Debug=portable（独立 .pdb）、Release=embedded（符号随程序集，无独立 .pdb 文件）。
       仓库工程与根 Directory.Build.props 的 Release=embedded 重复但无害（自包含）；模板生成工程无根 props，靠这里保证。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
