<Project>

  <!-- 平台选择集中定义：WebWindowUI 系列库（核心 + 两个角色标记库）共享。
       所有条件键控 $(WWUIPlatform) 而非裸 $([MSBuild]::IsOSPlatform(...))——
       否则 -p:WWUIPlatform=Linux 在 Windows 上会同时定义 WINDOWS 和 LINUX 两个符号。
       WWUIPlatform 可被命令行 -p:WWUIPlatform=<值> 覆盖（在 Windows 上做 Linux/macOS 编译检查）。 -->

  <PropertyGroup>
    <WWUIPlatform Condition="'$(WWUIPlatform)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">Windows</WWUIPlatform>
    <WWUIPlatform Condition="'$(WWUIPlatform)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">Linux</WWUIPlatform>
    <WWUIPlatform Condition="'$(WWUIPlatform)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">MacOS</WWUIPlatform>
    <WWUIPlatform Condition="'$(WWUIPlatform)' == ''">Windows</WWUIPlatform>

    <!-- macOS 的 net10.0-macos 无法在 Windows 上编译（需 Mac + macos workload）；
         Windows 上 -p:WWUIPlatform=MacOS 会因缺 Apple SDK 而编译失败，属预期。 -->
    <TargetFramework Condition="'$(WWUIPlatform)' == 'Windows'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(WWUIPlatform)' == 'MacOS'">net10.0-macos</TargetFramework>
    <TargetFramework Condition="'$(WWUIPlatform)' == 'Linux'">net10.0</TargetFramework>

    <DefineConstants Condition="'$(WWUIPlatform)' == 'Windows'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(WWUIPlatform)' == 'Linux'">$(DefineConstants);LINUX</DefineConstants>
    <DefineConstants Condition="'$(WWUIPlatform)' == 'MacOS'">$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>

</Project>
