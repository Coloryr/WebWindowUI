<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>WebWindowUI.Platforms.Cef</PackageId>
    <Description>WebWindowUI CEF 平台实现（CefSharp 绑定）</Description>
    <PackageTags>webwindowui;cef;chromium;cefsharp</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- CefSharp：浏览器托管层（ChromiumWebBrowser + BrowserSubprocess）。150.0.110 为 net462-only，经兼容引用运行于 net10.0-windows -->
    <PackageReference Include="CefSharp.WinForms" Version="150.0.110" />
    <PackageReference Include="CefSharp.Common" Version="150.0.110" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\WebWindowUI.Core\WebWindowUI.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(WWUIPlatform)' == 'Windows'">
    <ProjectReference Include="..\..\Natives\WebWindowUI.Natives.Windows\WebWindowUI.Natives.Windows.csproj" />
  </ItemGroup>

</Project>
