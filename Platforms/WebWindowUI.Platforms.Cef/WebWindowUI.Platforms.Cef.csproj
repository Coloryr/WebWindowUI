<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>WebWindowUI.Platforms.Cef</PackageId>
    <Description>WebWindowUI CEF 平台实现（CefGlue.Next NuGet 包，CEF 150）</Description>
    <PackageTags>webwindowui;cef;chromium;cefglue</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="CefGlue.Next.BrowserProcess.Core" />
    <PackageReference Include="CefGlue.Next.Core" />
    <PackageReference Include="CefGlue.Next.Common" />
    <PackageReference Include="CefGlue.Next.Common.Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\WebWindowUI.Core\WebWindowUI.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(WWUIPlatform)' == 'Windows'">
    <ProjectReference Include="..\..\Natives\WebWindowUI.Natives.Windows\WebWindowUI.Natives.Windows.csproj" />
  </ItemGroup>

</Project>
