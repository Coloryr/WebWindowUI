<Solution>
  <Folder Name="/Core/">
    <Project Path="WebWindowUI.Backend/WebWindowUI.Backend.csproj" />
    <Project Path="WebWindowUI.Frontend/WebWindowUI.Frontend.csproj" />
    <Project Path="WebWindowUI.Core/WebWindowUI.Core.csproj" />
    <Project Path="WebWindowUI/WebWindowUI.csproj" />
  </Folder>
  <Folder Name="/Platforms/">
    <!-- 平台包只入 Windows 版 slnx：Linux/macOS 平台工程 TFM（net10.0 / net10.0-macos）与
         Windows 侧核心（net10.0-windows）不匹配，放进共享 slnx 会在 Windows 上构建报错。
         它们在各自 OS 上作为独立工程构建（WWUIPlatform=Linux/MacOS）。 -->
    <Project Path="WebWindowUI.Platforms.Windows/WebWindowUI.Platforms.Windows.csproj" />
  </Folder>
  <Folder Name="/Generator/">
    <Project Path="WebWindowUI.Generator.SourceGen/WebWindowUI.Generator.SourceGen.csproj" />
    <Project Path="WebWindowUI.Generator/WebWindowUI.Generator.csproj" />
  </Folder>
  <Folder Name="/Sample/">
    <Project Path="Sample/WebWindowUI.Sample.Backend/WebWindowUI.Sample.Backend.csproj" />
    <Project Path="Sample/WebWindowUI.Sample.Frontend/WebWindowUI.Sample.Frontend.csproj" />
    <Project Path="Sample/WebWindowUI.Sample/WebWindowUI.Sample.csproj" />
  </Folder>
  <Folder Name="/Templates/">
    <Project Path="WebWindowUI.Templates/WebWindowUI.Templates.csproj" />
  </Folder>
  <Folder Name="/Test/">
    <Project Path="WebWindowUI.Tests/WebWindowUI.Tests.csproj" />
  </Folder>
</Solution>
