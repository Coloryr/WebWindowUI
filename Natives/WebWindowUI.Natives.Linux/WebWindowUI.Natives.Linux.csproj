<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>WebWindowUI.Natives.Linux</PackageId>
    <Description>WebWindowUI GTK3 原生 P/Invoke 共享层（GTK 窗口 + GObject 信号桥 + 窗口宿主），Linux WebKit 与 CEF 平台共用；webkit 绑定留在 WebWindowUI.Platforms.Linux。</Description>
    <PackageTags>webwindowui;webkit2gtk;gtk3;linux;native</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\WebWindowUI.Core\WebWindowUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebWindowUI.Platforms.Linux" />
  </ItemGroup>

</Project>
