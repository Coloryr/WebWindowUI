<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <_WWUI_IsMacHost Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</_WWUI_IsMacHost>
    <TargetFramework Condition="'$(_WWUI_IsMacHost)' == 'true'">net10.0-macos</TargetFramework>
    <TargetFramework Condition="'$(_WWUI_IsMacHost)' != 'true'">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>WebWindowUI.Natives.Macos</PackageId>
    <Description>WebWindowUI macOS 原生层（对话框等，镜像 Natives.Windows/Linux）。</Description>
    <PackageTags>webwindowui;macos</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(_WWUI_IsMacHost)' != 'true'">
    <Compile Remove="**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\WebWindowUI.Core\WebWindowUI.Core.csproj" />
  </ItemGroup>
</Project>
